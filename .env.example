# ──────────────────────────────────────────────
# DataForge Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://dataforge:dataforge_dev@localhost:5432/dataforge

# ── MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://dataforge:dataforge_dev@localhost:27017/dataforge?authSource=admin

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── S3 / MinIO ──────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dataforge
S3_SECRET_KEY=dataforge_dev
S3_BUCKET_STAGING=dataforge-staging
S3_BUCKET_PROCESSED=dataforge-processed
S3_BUCKET_ARCHIVE=dataforge-archive
S3_REGION=us-east-1

# ── OpenSearch ───────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── Auth / JWT ───────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Sumsub (KYC) ────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# ── Upload Service ───────────────────────────
UPLOAD_PORT=8080
UPLOAD_MAX_SIZE=2147483648

# ── ML Pipeline ──────────────────────────────
ML_PIPELINE_PORT=8082

# ── Transcoding ──────────────────────────────
TRANSCODING_PORT=8081

# ── Matching Service ─────────────────────────
MATCHING_PORT=8083

# ── Pricing Service ─────────────────────────
PRICING_PORT=8084
